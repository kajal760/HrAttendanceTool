# Copy this file to .env.local and fill in real values.
# .env.local is already git-ignored - never commit real credentials.

# --- SMTP (required to actually send birthday emails) ----------------------
# Works with Gmail (use an App Password), Office 365, SendGrid's SMTP relay,
# or any other SMTP provider.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="HR Attendance <hr@yourcompany.example>"

# --- Cron trigger auth (only needed if using the /api/birthdays/notify
# route with an HTTP-triggered scheduler like Vercel Cron) -----------------
CRON_SECRET=choose-a-long-random-string

# --- Backend (FastAPI, ../Hr Attendance Backend) ---------------------------
# Every data call goes server-side from Next.js to this API.
BACKEND_URL=http://localhost:8010/api/v1
# Signs the session cookie (which carries the backend token). Set a long
# random value outside local development.
SESSION_SECRET=change-me
# Account used only by jobs that run with nobody signed in (the birthday /
# anniversary cron routes and their CLI scripts). Use an Admin login.
BACKEND_SERVICE_EMAIL=admin@hrattendance.example
BACKEND_SERVICE_PASSWORD=admin123
